#!/usr/bin/env bash
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo is not installed or not in PATH" >&2
  exit 1
fi

if ! command -v black >/dev/null 2>&1; then
  echo "pre-commit: black is not installed or not in PATH" >&2
  exit 1
fi

echo "pre-commit: running cargo fmt --all"
cargo fmt --all

echo "pre-commit: running black on Python scripts"
black scripts/*.py

# Stage files changed by formatter so commit includes formatting updates.
git add -u
